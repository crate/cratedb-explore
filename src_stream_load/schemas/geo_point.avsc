{
  "type": "record",
  "name": "GeoPoint",
  "namespace": "demo.stream_load",
  "doc": "A weather-station location from geo_points.json.",
  "fields": [
    {"name": "latitude", "type": "double"},
    {"name": "longitude", "type": "double"},
    {"name": "geo_location", "type": {"type": "array", "items": "double"}, "doc": "[longitude, latitude]"},
    {"name": "nearest_town", "type": "string"}
  ]
}
