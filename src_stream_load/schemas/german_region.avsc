{
  "type": "record",
  "name": "GermanRegion",
  "namespace": "demo.stream_load",
  "doc": "A German Land (state) from german_regions.json.",
  "fields": [
    {"name": "region_name", "type": "string"},
    {"name": "geo_coords", "type": "string", "doc": "Raw GeoJSON geometry (Polygon or MultiPolygon) as a JSON string."},
    {"name": "tourism_info", "type": "string"},
    {"name": "transportation", "type": "string"},
    {"name": "economics", "type": "string"},
    {"name": "introduced_species", "type": "string"},
    {"name": "embedding", "type": {"type": "array", "items": "double"}, "doc": "1536-dimension text embedding."}
  ]
}
